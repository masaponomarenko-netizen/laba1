<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpreadsheetApp.MainPage"
             Title="Електронна таблиця">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="10" RowSpacing="8">

        <ScrollView Grid.Row="0" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="6">
                <Button Text="Зберегти" Clicked="SaveButton_Clicked" />
                <Button Text="Прочитати" Clicked="ReadButton_Clicked" />
                <Button Text="Порахувати" Clicked="CalculateButton_Clicked" />
                <Button x:Name="modeButton" Text="Режим: ВИРАЗ" Clicked="ModeButton_Clicked" />
                <Button Text="Додати рядок" Clicked="AddRowButton_Clicked" />
                <Button Text="Додати стовпчик" Clicked="AddColumnButton_Clicked" />
                <Button Text="Видалити рядок" Clicked="DeleteRowButton_Clicked" />
                <Button Text="Видалити стовпчик" Clicked="DeleteColumnButton_Clicked" />
                <Button Text="Довідка" Clicked="HelpButton_Clicked" />
                <Button Text="Вийти" Clicked="ExitButton_Clicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Entry x:Name="textInput"
               Grid.Row="1"
               Placeholder="Введіть вираз, напр. =max(A1,B1)+2*3, і натисніть Enter"
               Completed="FormulaBar_Completed" />

        <Label x:Name="statusLabel"
               Grid.Row="2"
               FontSize="12"
               TextColor="Gray"
               Text="" />

        <ScrollView Grid.Row="3" Orientation="Both">
            <Grid x:Name="grid" />
        </ScrollView>
    </Grid>

</ContentPage>
